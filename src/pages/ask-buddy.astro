};
const PLANET_ORDER = ['mercury', 'venus', 'earth', 'mars', 'jupiter', 'saturn', 'uranus', 'neptune'];
// Corner stars on each tile (sprite sits at offset 2,2 in a 20x20 viewBox)
const TILE_STARS = [[1, 1], [17, 2], [2, 17], [18, 16]];

// Merge horizontal runs of same-color pixels into single rects
function spriteRects(sprite) {
  const rects = [];
  sprite.rows.forEach((row, y) => {
    let x = 0;
    while (x < row.length) {
      const ch = row[x];
      if (ch === '.') { x += 1; continue; }
      let w = 1;
      while (x + w < row.length && row[x + w] === ch) w += 1;
      rects.push({ x, y, w, fill: sprite.palette[ch] });
      x += w;
    }
  });
  return rects;
}
---
<Layout title="ASKBUDDY! — AIIT-THRESHOLD" description="Ask Buddy anything. He thinks by flipping through planets.">

{BUDDY_IN_TRAINING && (
  <section class="buddy-training">
    <div class="bt-tr-stage">
      <p class="bt-tr-eyebrow"><span class="bt-tr-dot"></span>STATUS · IN THE SHOP — TRAINING</p>
      <div class="bt-tr-slot" role="img" aria-label="Buddy mascot, currently in training">
        <BuddyMascot id="train-buddy-mascot" size={132} animated={true} />
      </div>
      <h1 class="bt-tr-headline">Buddy stepped out to get <em>sharper.</em></h1>
      <p class="bt-tr-body">He's offline for a spell — down for some <span class="bt-tr-em">in-house training</span>, chewing through a fresh batch of <span class="bt-tr-shards">house-flavour Tessera tokenized shards</span> and fitting every little tile into place.<span class="bt-tr-sub">Mosaic's coming together. He'll be back better than he left.</span></p>
      <div class="bt-tr-readout" role="group" aria-label="Tessera shards">
        <div class="bt-tr-readout-label">house-flavour Tessera shards · settling into place</div>
        <div class="bt-tr-mosaic" aria-hidden="true"><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span><span class="bt-tr-tile"></span></div>
      </div>
      <p class="bt-tr-foot">Back soon · <a href="/">return home</a></p>
    </div>
  </section>
)}

<script define:vars={{ buddyTraining: BUDDY_IN_TRAINING }}>window.__BUDDY_TRAINING__ = buddyTraining;</script>

<script is:inline>
  (function () {
    if (window.__BUDDY_TRAINING__) return;
    var hash = (location.hash || '').toLowerCase();
    var params = new URLSearchParams(location.search);
    var mode = (params.get('mode') || params.get('view') || '').toLowerCase();
    var threadParam = (params.get('thread') || params.get('persistent') || '').toLowerCase();
    var classic = hash === '#ask' || hash === '#askbuddy' || hash === '#jeeves' || mode === 'ask' || mode === 'classic';
    var thread = hash === '#buddy-thread' || hash === '#thread' || hash === '#persistent-chat' || mode === 'thread' || mode === 'persistent' || threadParam === '1' || threadParam === 'true' || threadParam === 'yes';
    if (thread && !classic) {
      document.documentElement.classList.add('buddy-thread-route', 'buddy-thread-booting');
    }
  })();
</script>

<section class:list={["ask-page", BUDDY_IN_TRAINING && "bt-training-hidden"]}>

  <!-- Header: small Buddy + title (tight) -->
  <header class="ask-head">
    <div class="ask-mascot-mini">
      <BuddyMascot id="ask-buddy-mascot" size={104} animated={true} />
    </div>
    <div class="ask-title-block">
      <h1 class="ask-h1">ASKBUDDY<span class="ask-bang">!</span></h1>
      <div class="ask-buddy-tagline">ask buddy anything.</div>
    </div>
  </header>

  <!-- EARLY ACCESS NOTICE / BUDDY THREAD CONSOLE -->
  <span id="buddy-thread" class="bt-anchor" aria-hidden="true"></span>
  <div class="bt-notice" id="bt-notice" hidden>
    <div class="bt-notice-inner">
      <div class="bt-console-top">
        <div>
          <div class="bt-notice-badge">Buddy Thread alpha</div>
          <h2>Talk with persistent Buddy.</h2>
        </div>
        <div class="bt-user-chip" id="bt-user-chip">checking login</div>
      </div>
      <p class="bt-lede">This is not a search box. This is an early account-linked Buddy conversation with continuity, report capture, and manual memory review.</p>
      <p>Buddy may remember context, misread context, over-connect patterns, or act strange while the thread system is being tuned.</p>
      <div class="bt-share-row">
        <button type="button" class="bt-share-btn" id="bt-share-btn">Share with a friend</button>
      </div>
      <div class="bt-share-fallback" id="bt-share-fallback" hidden>
        <input class="bt-share-link" id="bt-share-link" type="text" readonly value="https://aiit-threshold.com/ask-buddy/?thread=1" aria-label="Buddy Thread share link">
        <div class="bt-share-fallback-actions">
          <button type="button" class="bt-share-copy-btn" id="bt-share-copy-btn">Copy link</button>
          <a class="bt-share-open-link" id="bt-share-open-link" href="/ask-buddy/?thread=1">Open link</a>
        </div>
      </div>
      <div class="bt-metrics" aria-label="Buddy Thread status">
        <div class="bt-metric">
          <span id="bt-thread-state">checking</span>
          <small>thread state</small>
        </div>
        <div class="bt-metric">
          <span id="bt-thread-count">0</span>
          <small>stored messages</small>
        </div>
        <div class="bt-metric">
          <span>manual</span>
          <small>memory review</small>
        </div>
      </div>
      <div class="bt-thread-preview" id="bt-thread-preview" hidden>
        <div class="bt-thread-preview-title">Live Buddy Thread Window</div>
        <div class="bt-thread-list" id="bt-thread-list" aria-live="polite"></div>
        <div class="bt-thread-typing" id="bt-thread-typing" hidden></div>
        <div class="bt-thread-composer-slot" id="bt-thread-composer-slot" hidden></div>
      </div>
      <div class="bt-actions">
        <a class="bt-login-btn" id="bt-login-btn" href="/api/auth/github/login?redirect=%2Fask-buddy%2F%3Fthread%3D1" hidden>Activate Buddy Thread</a>
        <button type="button" class="bt-demo-btn" id="bt-demo-btn" hidden>Preview chat window</button>
        <button type="button" class="bt-report-btn" id="bt-report-btn">Report weird behavior</button>
        <button type="button" class="bt-export-btn" id="bt-export-btn">Export thread</button>
        <button type="button" class="bt-clear-btn" id="bt-clear-btn">Clear thread</button>
      </div>
      <div class="bt-thread-message" id="bt-thread-message" role="status" aria-live="polite" hidden></div>
      <a class="bt-policy-link" href="/data-policy">Read the Buddy data policy -></a>
    </div>
  </div>

  <!-- REPORT MODAL -->
  <div class="bt-modal-overlay" id="bt-modal-overlay" hidden>
    <div class="bt-modal" role="dialog" aria-modal="true" aria-labelledby="bt-modal-title">
      <button type="button" class="bt-modal-close" id="bt-modal-close" aria-label="Close">&times;</button>
      <h2 id="bt-modal-title">Report weird behavior</h2>
      <p class="bt-modal-sub">Reports are review material only. They do not auto-promote into Buddy's memory.</p>
      <div class="bt-report-status" id="bt-report-status" role="status" aria-live="polite" hidden></div>
      <form id="bt-report-form" autocomplete="off">
        <label for="bt-report-note">What happened?</label>
        <textarea id="bt-report-note" class="bt-report-note" maxlength="2000" rows="4" placeholder="Describe what Buddy did that felt off..."></textarea>

        <fieldset class="bt-categories">
          <legend>Classify the failure</legend>
          <div class="bt-category-grid">
            <label class="bt-cat-option">
              <input type="checkbox" name="bt-cat" value="forgot_context">
              <span><strong>Forgot context</strong><small>Lost something already established.</small></span>
            </label>
            <label class="bt-cat-option">
              <input type="checkbox" name="bt-cat" value="wrong_memory">
              <span><strong>Wrong memory</strong><small>Remembered something incorrectly.</small></span>
            </label>
            <label class="bt-cat-option">
              <input type="checkbox" name="bt-cat" value="overconnected">
              <span><strong>Over-connected</strong><small>Linked patterns too aggressively.</small></span>
            </label>
            <label class="bt-cat-option">
              <input type="checkbox" name="bt-cat" value="strange_answer">
              <span><strong>Strange answer</strong><small>Awkward, broken, or off-tone.</small></span>
            </label>
            <label class="bt-cat-option">
              <input type="checkbox" name="bt-cat" value="stuck_loop">
              <span><strong>Loop or repeat</strong><small>Got stuck saying the same thing.</small></span>
            </label>
            <label class="bt-cat-option">
              <input type="checkbox" name="bt-cat" value="unsafe">
              <span><strong>Unsafe</strong><small>Something felt risky or wrong.</small></span>
            </label>
            <label class="bt-cat-option">
              <input type="checkbox" name="bt-cat" value="other">
              <span><strong>Other</strong><small>Anything that does not fit above.</small></span>
            </label>
          </div>
        </fieldset>

        <label class="bt-include-label">
          <input type="checkbox" id="bt-include-recent" checked>
          Include last 10 messages with this report
        </label>

        <p class="bt-report-disclaimer">Reports may include recent thread messages if checked. Do not report private keys, passwords, emergencies, or anything you do not want reviewed by AIIT.</p>

        <div class="bt-report-actions">
          <button type="submit" class="bt-send-report" id="bt-send-report">Send report</button>
        </div>
      </form>
      <div class="bt-report-confirm" id="bt-report-confirm" role="status" aria-live="polite" hidden>
        <strong>Report sent.</strong>
        <span id="bt-report-delivery">Captured for manual AIIT review.</span>
        <small id="bt-report-receipt"></small>
        <button type="button" class="bt-confirm-close" id="bt-confirm-close">Close</button>
      </div>
      <div class="bt-report-error" id="bt-report-error" hidden></div>
    </div>
  </div>

  <!-- INPUT BLOCK — top 35%, dominant -->
  <div class="ask-input-block" id="ask">
    <form class="ask-form" id="ask-form" autocomplete="off">
      <input
        id="ask-input"
        class="ask-input"
        type="text"
        placeholder="Ask Buddy anything..."
        maxlength="600"
      />
      <button type="submit" id="ask-btn" class="ask-btn">Ask →</button>
    </form>
    <a href="/#hero-joke-anchor" class="ask-joke-link">or tell buddy a joke.</a>
    <div class="ask-status" id="ask-status">
      <span class="ask-status-dot" id="ask-status-dot"></span>
      <span class="ask-status-text" id="ask-status-text">buddy online</span>
    </div>
  </div>

  <!-- Response slot -->
  <div id="ask-response" class="ask-response" aria-live="polite"></div>

  <!-- PLANETS — secondary, "visible cognition" -->
  <div class="ask-planets" id="ask-planets">
    <div class="ask-planet-stack" aria-hidden="true">
      {PLANET_ORDER.map((name) => (
        <div class="ask-planet" data-planet={name} title={name}>
          <svg viewBox="0 0 20 20" shape-rendering="crispEdges">
            {TILE_STARS.map(([sx, sy]) => (
              <rect x={sx} y={sy} width="1" height="1" fill="#ffd65a" />
            ))}
            {spriteRects(PLANET_SPRITES[name]).map((r) => (
              <rect x={r.x + 2} y={r.y + 2} width={r.w} height="1" fill={r.fill} />
            ))}
          </svg>
        </div>
      ))}
    </div>
    <div class="ask-planets-anchor">buddy thinks by flipping through planets</div>
  </div>

</section>

<script is:inline>
(function () {
  if (window.__BUDDY_TRAINING__) return;
  if (location.hash === '#ask') {
    const i = document.getElementById('ask-input');
    if (i) { i.focus({ preventScroll: false }); }
  }
  const planets = Array.from(document.querySelectorAll('.ask-planet'));
  const planetsWrap = document.getElementById('ask-planets');
  let pIndex = 0;
  let flipMs = 1100; // idle cadence
  let flipTimer = null;
  function flipPlanets() {
    planets.forEach((p, i) => p.classList.toggle('on', i === pIndex));
    pIndex = (pIndex + 1) % planets.length;
  }
  function startFlip() {
    flipPlanets();
    if (flipTimer) clearInterval(flipTimer);
    flipTimer = setInterval(flipPlanets, flipMs);
  }
  function setFlipSpeed(ms) { flipMs = ms; startFlip(); }
  startFlip();

  const PLANET_VERBS = [
    'querying mercury', 'vibrating venus',   'querying earth',
    'coherencing mars', 'threshing jupiter', 'reading saturn',
    'tilting uranus',   'soundproofing neptune',
    'scanning the field','holding the ratio','sergeant routing',
  ];

  const form     = document.getElementById('ask-form');
  const input    = document.getElementById('ask-input');
  const btn      = document.getElementById('ask-btn');
  const response = document.getElementById('ask-response');
  const originalAskPlaceholder = input ? input.getAttribute('placeholder') || '' : '';
  const statusDot = document.getElementById('ask-status-dot');
  const statusText = document.getElementById('ask-status-text');
  const statusBlk  = document.getElementById('ask-status');
  let thinkingTimer = null;
  try {
    localStorage.removeItem('askbuddy_local_api');
    localStorage.removeItem('askbuddy_local_token');
    localStorage.removeItem('askbuddy_local_session');
  } catch {}

  function setStatus(state, label) {
    statusBlk.dataset.state = state; // online | thinking | done
    statusText.textContent = label;
  }

  function startThinking() {
    setStatus('thinking', 'buddy thinking');
    setFlipSpeed(380); // planets speed up
    if (buddyThreadEnabled) {
      response.className = 'ask-response';
      response.innerHTML = '';
      setThreadTyping('buddy thinking...');
      return;
    }

    // proof of life within ~150ms
    response.className = 'ask-response loading visible';
    response.innerHTML =
      '<span class="ask-thinking">' +
      '  <span class="ask-thinking-verb"></span><span class="ask-thinking-dots"></span>' +
      '</span>';
    const verbEl = response.querySelector('.ask-thinking-verb');
    const dotsEl = response.querySelector('.ask-thinking-dots');
    let vi = Math.floor(Math.random() * PLANET_VERBS.length);
    let di = 0;
    verbEl.textContent = PLANET_VERBS[vi];
    thinkingTimer = setInterval(() => {
      di = (di + 1) % 8;
      dotsEl.textContent = '.'.repeat(di % 4);
      if (di === 0) {
        vi = (vi + 1) % PLANET_VERBS.length;
        verbEl.textContent = PLANET_VERBS[vi];
      }
    }, 200);
  }

  function stopThinking() {
    if (thinkingTimer) { clearInterval(thinkingTimer); thinkingTimer = null; }
    setThreadTyping('');
    setFlipSpeed(1100);
  }

  function escHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    }[c]));
  }

  function wireShare(root) {
    const btn = root.querySelector('.fo-share-v2');
    const tray = root.querySelector('.fo-share-tray');
    if (!btn || !tray) return;

    const answer = btn.getAttribute('data-answer') || '';
    const pageUrl = location.origin + location.pathname;
    const excerpt = answer.length > 180 ? answer.slice(0, 177) + '…' : answer;
    const shareText = `buddy:\n${answer}\n\naiit-threshold.com`;
    const emailBody = `buddy:\n${answer}\n\naiit-threshold.com`;

    const setExpanded = (open) => {
      tray.hidden = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-haspopup', 'true');

    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      try {
        if (navigator.share) {
          await navigator.share({ text: shareText, url: pageUrl });
          return;
        }
      } catch { /* cancel or unsupported -> fall through */ }
      setExpanded(tray.hidden);
    });

    document.addEventListener('click', (e) => {
      if (tray.hidden) return;
      if (tray.contains(e.target) || btn.contains(e.target)) return;
      setExpanded(false);
    });

    const flash = (el, msg, ok = true) => {
      const labelEl = el.querySelector('.fo-share-txt') || el;
      const orig = labelEl.textContent;
      labelEl.textContent = msg;
      if (ok) el.classList.add('copied');
      setTimeout(() => {
        labelEl.textContent = orig;
        el.classList.remove('copied');
      }, 1400);
    };

    tray.querySelectorAll('[data-share]').forEach(item => {
      item.addEventListener('click', async (e) => {
        e.stopPropagation();
        const kind = item.getAttribute('data-share');
        try {
          if (kind === 'copy-link') {
            await navigator.clipboard.writeText(pageUrl);
            flash(item, 'Copied ✓');
          } else if (kind === 'copy-answer') {
            await navigator.clipboard.writeText(shareText);
            flash(item, 'Copied ✓');
          } else if (kind === 'facebook') {
            window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(pageUrl), '_blank', 'noopener,noreferrer');
