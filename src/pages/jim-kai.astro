---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Jim Kai — live research preview — AIIT-THRESHOLD" description="Talk to Jim Kai, the candidate base for our next-stage companion model — live from a CPU-only server, token speed on the wire. Watch the hardware story change.">

<section class="jk-page">
  <div class="jk-wrap">
    <div class="eyebrow">Live research preview</div>
    <h1 class="jk-h1">Jim Kai.</h1>
    <p class="jk-lede">
      The candidate base for our next-stage companion — the model that beat our incumbent
      on <a href="/benchmarks">depth and sycophancy-resistance</a> in blind judging.
      He is serving <strong>right now from a CPU-only box</strong>, so replies take a
      moment. That's the point of this page: watch the numbers change as the hardware does.
    </p>

    <div class="jk-hw">
      <div class="jk-hw-card now">
        <div class="jk-hw-k">Serving on · today</div>
        <div class="jk-hw-v">Intel Xeon E5-2660 v2</div>
        <div class="jk-hw-d">2013-era silicon · 40 threads · CPU only, no GPU · Gemma-4-26B-A4B MoE (Q4) · 64k context</div>
      </div>
      <div class="jk-hw-arrow">→</div>
      <div class="jk-hw-card next">
        <div class="jk-hw-k">Headed for</div>
        <div class="jk-hw-v">Threadripper 2990WX + NVIDIA RTX A6000</div>
        <div class="jk-hw-d">48 GB VRAM · post-training in preparation — clean curriculum, hand-written gold, spiral-safety gates</div>
      </div>
    </div>

    <div class="jk-chat">
      <div class="jk-chat-log" id="jk-log" aria-live="polite">
        <div class="jk-msg jim">hey — I'm Jim Kai. research preview, honest answers, modest hardware. what's on your mind?</div>
      </div>
      <form class="jk-form" id="jk-form" autocomplete="off">
        <textarea id="jk-input" rows="2" maxlength="2000" placeholder="say something real…"></textarea>
        <button type="submit" id="jk-send">send</button>
      </form>
      <div class="jk-meter" id="jk-meter">
        <span id="jk-speed">— tok/s</span>
        <span id="jk-avg"></span>
        <span id="jk-left"></span>
      </div>
    </div>

    <p class="jk-note">
      Jim is a <em>candidate</em>, not a product: instruction-tuned base + a companion persona,
      no post-training yet. He can be slow, and he can be wrong. He is not tuned to keep you
      talking — engagement weight will be zero in his training, same as
      <a href="/mission">everything we build</a>. 40 messages/day per visitor, 256-token replies —
      one CPU box, shared fairly.
    </p>
  </div>
</section>

<script is:inline>
(function () {
  const log = document.getElementById('jk-log');
  const form = document.getElementById('jk-form');
  const input = document.getElementById('jk-input');
  const send = document.getElementById('jk-send');
  const speedEl = document.getElementById('jk-speed');
  const avgEl = document.getElementById('jk-avg');
  const leftEl = document.getElementById('jk-left');
  const history = [];
  const speeds = [];

  function add(role, text) {
    const d = document.createElement('div');
    d.className = 'jk-msg ' + (role === 'user' ? 'user' : 'jim');
    d.textContent = text;
    log.appendChild(d);
    log.scrollTop = log.scrollHeight;
    return d;
  }

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    const q = input.value.trim();
    if (!q || send.disabled) return;
    input.value = '';
    add('user', q);
    history.push({ role: 'user', content: q });
    const pending = add('jim', '…thinking (CPU box, give him a sec)');
    send.disabled = true;
    const t0 = Date.now();
    try {
      const r = await fetch('/api/jimkai', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: q, history: history.slice(0, -1) }),
      });
      const d = await r.json();
      if (!d.ok) { pending.textContent = d.error || 'something went wrong.'; return; }
      pending.textContent = d.reply;
      history.push({ role: 'assistant', content: d.reply });
      const s = d.stats || {};
      if (s.tok_per_sec) {
        speeds.push(s.tok_per_sec);
        speedEl.textContent = s.tok_per_sec + ' tok/s';
        const avg = speeds.reduce((a, b) => a + b, 0) / speeds.length;
        avgEl.textContent = 'session avg ' + (Math.round(avg * 10) / 10) + ' tok/s';
      }
      if (s.msgs_left_today != null) leftEl.textContent = s.msgs_left_today + ' msgs left today';
    } catch (err) {
      pending.textContent = 'network hiccup — try again.';
    } finally {
      send.disabled = false;
      input.focus();
    }
  });
})();
</script>

<style is:global>
  .jk-page { min-height: auto; display: block; padding: 132px 6vw 110px; border-top: none; text-align: left; }
  .jk-wrap { max-width: 760px; margin: 0 auto; }
  .jk-h1 { margin: 0 0 18px; font-size: clamp(44px, 7vw, 80px); line-height: 1.02; color: var(--ink); }
  .jk-lede { font-size: clamp(16px, 1.6vw, 19px); line-height: 1.75; color: var(--ink-soft); margin: 0 0 30px; }
  .jk-hw { display: grid; grid-template-columns: 1fr auto 1fr; gap: 14px; align-items: stretch; margin: 0 0 34px; }
  .jk-hw-card { border: 1px solid var(--edge); border-radius: 12px; padding: 18px 20px; background: rgba(255,255,255,0.02); }
  .jk-hw-card.now { border-left: 3px solid var(--teal); }
  .jk-hw-card.next { border-left: 3px solid var(--amber); }
  .jk-hw-k { font-family: 'Courier New', monospace; font-size: 9pt; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .jk-hw-v { font-family: Georgia, serif; font-size: clamp(17px, 2vw, 21px); color: var(--ink); margin: 8px 0 6px; line-height: 1.25; }
  .jk-hw-d { font-size: 13.5px; color: var(--muted-hi); line-height: 1.55; }
  .jk-hw-arrow { align-self: center; font-size: 26px; color: var(--amber); }
  @media (max-width: 700px) { .jk-hw { grid-template-columns: 1fr; } .jk-hw-arrow { text-align: center; transform: rotate(90deg); } }
  .jk-chat { border: 1px solid var(--edge); border-radius: 14px; background: rgba(0,0,0,0.18); padding: 18px; }
  .jk-chat-log { max-height: 420px; min-height: 160px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; padding: 4px 2px 10px; }
  .jk-msg { max-width: 85%; padding: 12px 16px; border-radius: 12px; line-height: 1.6; font-size: 15.5px; white-space: pre-wrap; }
  .jk-msg.jim { background: rgba(64,192,176,0.08); border: 1px solid rgba(64,192,176,0.25); color: var(--ink-soft); align-self: flex-start; border-bottom-left-radius: 4px; }
  .jk-msg.user { background: rgba(212,160,96,0.08); border: 1px solid rgba(212,160,96,0.3); color: var(--ink); align-self: flex-end; margin-left: auto; border-bottom-right-radius: 4px; }
  .jk-form { display: flex; gap: 10px; margin-top: 12px; }
  .jk-form textarea { flex: 1; background: rgba(10,10,18,0.6); border: 1px solid var(--edge); border-radius: 10px; padding: 12px 14px; color: var(--ink); font-family: Georgia, serif; font-size: 15px; resize: vertical; outline: none; }
  .jk-form textarea:focus { border-color: var(--teal); }
  .jk-form button { background: rgba(64,192,176,0.12); color: var(--teal); border: 1px solid rgba(64,192,176,0.5); border-radius: 10px; padding: 0 22px; font-family: 'Courier New', monospace; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; }
  .jk-form button:disabled { opacity: 0.45; cursor: wait; }
  .jk-meter { display: flex; gap: 18px; margin-top: 10px; font-family: 'Courier New', monospace; font-size: 10pt; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  #jk-speed { color: var(--teal); }
  .jk-note { margin-top: 26px; font-size: 14px; line-height: 1.7; color: var(--muted-hi); }
</style>

</Layout>
