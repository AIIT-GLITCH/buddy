<script is:inline>
  // ---- Voice call hero: the REAL pipeline (same client as jim-call's
  // proven call.html), pointed at the public tunnel. No token — the
  // tunnel stamps CF-Connecting-IP and the server treats us as a public
  // caller with a per-visitor AND per-IP daily budget.
  (function () {
    const CALL_HOST = "jim.aiit-threshold.com";
    const CALLER_KEY_STORE = "aiit_call_caller_key";
    function callerKey() {
      let k = localStorage.getItem(CALLER_KEY_STORE);
      if (!k) {
        k = "web_" + crypto.randomUUID().replace(/-/g, "").slice(0, 24);
        localStorage.setItem(CALLER_KEY_STORE, k);
      }
      return k;
    }

    // ---- Buddy family line unlock ----
    // Arm a device ONCE by visiting /#famtoken=<token>; stored locally and
    // stripped from the URL immediately. Without it this page is byte-for-
    // byte the public experience: Buddy stays "coming soon". The token is
    // sent as a WS subprotocol (never in the URL) and the server refuses
    // Buddy's lane without it — this unlock is cosmetic, the gate is his.
    const FAMILY_TOKEN_STORE = "aiit_call_family_token";
    (function armFamily() {
      const m = (location.hash || "").match(/famtoken=([A-Za-z0-9_-]+)/);
      if (m) {
        localStorage.setItem(FAMILY_TOKEN_STORE, m[1]);
        history.replaceState(null, "", location.pathname + location.search);
      }
    })();
    const familyToken = () => localStorage.getItem(FAMILY_TOKEN_STORE) || "";

    // ---- in-app-browser detection ----
    // Facebook/Instagram/TikTok/etc. embed a sandboxed WebView that commonly
    // blocks or silently deadens microphone access (the host app, not this
    // page, owns the OS mic permission) — getUserMedia() can resolve with no
    // error yet capture nothing. This is a UX nudge only, never a security
    // gate: UA strings are trivially spoofable. Order matters — named apps
    // are checked before the generic WebView fallbacks, since most of them
    // are themselves built on Android System WebView / WKWebView and would
    // otherwise be miscategorized as "unknown".
    function detectInAppBrowser(ua) {
      try {
        if (typeof ua !== "string" || ua.length === 0) return null;
        const test = (re) => re.test(ua);
        if (test(/\bInstagram\b/i)) return { platform: "Instagram" };
        if (test(/\bBarcelona\b/i)) return { platform: "Threads" };
        if (test(/FBAN\/(?:MESSENGER|Messenger)|FB_IAB\/MESSENGER|\bMessenger[\/;]/i)) return { platform: "Messenger" };
        if (test(/FBAN\/|FBAV\/|FB_IAB\/|FB4A|FBIOS|\bFacebook\b/i)) return { platform: "Facebook" };
        if (test(/musical_ly|BytedanceWebview|\bTikTok\b/i)) return { platform: "TikTok" };
        if (test(/LinkedInApp/i)) return { platform: "LinkedIn" };
        if (test(/\bSnapchat\b/i)) return { platform: "Snapchat" };
        if (test(/\[Pinterest\/|Pinterest\/(?:iOS|Android)\b/i)) return { platform: "Pinterest" };
        if (test(/MicroMessenger/i)) return { platform: "WeChat" };
        if (test(/\bLine\//i)) return { platform: "Line" };
        if (test(/\bTwitter\b/i)) return { platform: "Twitter/X" };
        if (test(/Android/i) && test(/;\s?wv\)/i)) return { platform: "this app's" };
        if (test(/iPhone|iPad|iPod/i) && !test(/Safari\//i)) return { platform: "this app's" };
        return null;
      } catch (e) { return null; }
    }

    const $ = (id) => document.getElementById(id);
    const panel = $("callPanel"), screen = $("callScreen"), choices = $("callChoices");
    const callName = $("callName"), callState = $("callState"), transcriptEl = $("callTranscript");
    const endCallBtn = $("endCallBtn"), timerFace = $("timerFace"), timerFill = $("timerFill");
    const voiceRing = $("voiceRing"), callErr = $("callErr"), jimBudget = $("jimBudget");
    const inAppWarn = $("callInAppWarn");
    if (!panel) return;

    (function warnIfInApp() {
      const hit = detectInAppBrowser(navigator.userAgent);
      if (hit && inAppWarn) {
        inAppWarn.textContent = `Voice calls don't work reliably in ${hit.platform} built-in browser — tap the ••• or share menu and choose "Open in Browser" for the best chance of the mic working.`;
        inAppWarn.hidden = false;
      }
    })();

    let activePersona = "jimkai", activeName = "JimK.ai";
    let ws = null, audioCtx = null, sourceNode = null, processor = null, mediaStream = null;
    let outputRate = 24000, playCursor = 0;
    const playing = new Set();
    let timerId = 0, secondsRemaining = 300;
    let lastVoiceAt = 0, silenceWatchdogId = 0;
    const SILENCE_TIMEOUT_MS = 22000, VOICE_RMS_FLOOR = 0.01;

    // ---- budget display (best-effort) ----
    async function refreshBudget() {
      try {
        const r = await fetch(`https://${CALL_HOST}/api/call_budget?caller_key=${encodeURIComponent(callerKey())}&persona=jimkai`);
        const d = await r.json();
        const secs = Math.max(0, Math.round(d.seconds_remaining));
        if (secs >= 300) jimBudget.textContent = "5:00 free today";
        else if (secs <= 0) jimBudget.textContent = "Today's minutes are used — back tomorrow";
        else jimBudget.textContent = `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, "0")} left today`;
      } catch (e) { /* display only */ }
    }
    refreshBudget();

    // Buddy's line is LIVE for everyone (2026-07-07). Family-armed
    // devices (famtoken) transparently ride his family lane; everyone
    // else gets his public lane — the server decides, the button is one.
    const buddyBudget = $("buddyBudget");
    async function refreshBuddyBudget() {
      try {
        const r = await fetch(`https://${CALL_HOST}/api/call_budget?caller_key=${encodeURIComponent(callerKey())}&persona=buddy`);
        const d = await r.json();
        const secs = Math.max(0, Math.round(d.seconds_remaining));
        if (secs >= 300) buddyBudget.textContent = "5:00 free today";
        else if (secs <= 0) buddyBudget.textContent = "Today's minutes are used — back tomorrow";
        else buddyBudget.textContent = `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, "0")} left today`;
      } catch (e) { /* display only */ }
    }
    refreshBuddyBudget();

    // ---- audio plumbing (proven pipeline, 24kHz context matches Orpheus) ----
    function downsample(input, inRate, outRate) {
      if (outRate === inRate) return input;
      const ratio = inRate / outRate, len = Math.floor(input.length / ratio);
      const out = new Float32Array(len);
      for (let i = 0; i < len; i++) {
        const start = Math.floor(i * ratio), end = Math.min(Math.floor((i + 1) * ratio), input.length);
        let sum = 0;
        for (let j = start; j < end; j++) sum += input[j];
        out[i] = sum / Math.max(1, end - start);
      }
      return out;
    }
    function floatToPcm16(f32) {
      const buf = new ArrayBuffer(f32.length * 2), view = new DataView(buf);
      for (let i = 0; i < f32.length; i++) {
        const s = Math.max(-1, Math.min(1, f32[i]));
        view.setInt16(i * 2, s < 0 ? s * 0x8000 : s * 0x7fff, true);
      }
      return buf;
    }
    function pcm16ToFloat32(buf) {
      const view = new DataView(buf), samples = new Float32Array(Math.floor(buf.byteLength / 2));
      for (let i = 0; i < samples.length; i++) samples[i] = view.getInt16(i * 2, true) / 32768;
      return samples;
    }
    function rms(samples) {
      let sum = 0;
      for (let i = 0; i < samples.length; i++) sum += samples[i] * samples[i];
      return Math.sqrt(sum / Math.max(1, samples.length));
    }
    function setVoiceActivity(input, output) {
      voiceRing.style.setProperty("--voice-in", Math.max(0, Math.min(1, input)).toFixed(3));
      voiceRing.style.setProperty("--voice-out", Math.max(0, Math.min(1, output)).toFixed(3));
    }

    async function startMic() {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        const e = new Error("mediaDevices unavailable"); e.name = "NotSupportedError"; throw e;
      }
      if (!window.AudioContext && !window.webkitAudioContext) {
        const e = new Error("AudioContext unavailable"); e.name = "NotSupportedError"; throw e;
      }
      if (!audioCtx) {
        try { audioCtx = new AudioContext({ sampleRate: 24000 }); }
        catch (e) { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
      }
      if (audioCtx.state === "suspended") await audioCtx.resume();
      playCursor = Math.max(playCursor, audioCtx.currentTime);
      mediaStream = await navigator.mediaDevices.getUserMedia({
        audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true, autoGainControl: true },
      });
      const track = mediaStream.getAudioTracks()[0];
      if (track) {
        track.onended = () => { callErr.textContent = "Your microphone stopped — the call has ended."; if (ws) ws.close(1000, "mic track ended"); };
        track.onmute = () => { lastVoiceAt = 0; };
      }
      lastVoiceAt = Date.now();
      sourceNode = audioCtx.createMediaStreamSource(mediaStream);
      processor = audioCtx.createScriptProcessor(4096, 1, 1);
      processor.onaudioprocess = (event) => {
        const input = event.inputBuffer.getChannelData(0);
        const level = rms(input);
        if (level >= VOICE_RMS_FLOOR) lastVoiceAt = Date.now();
        setVoiceActivity(level * 6, 0);
        if (!ws || ws.readyState !== WebSocket.OPEN) return;
        const down = downsample(input, audioCtx.sampleRate, 16000);
        if (down.length) ws.send(floatToPcm16(down));
      };
      sourceNode.connect(processor);
      processor.connect(audioCtx.destination);
    }
    function stopMic() {
      if (processor) processor.disconnect();
      if (sourceNode) sourceNode.disconnect();
      if (mediaStream) mediaStream.getTracks().forEach((t) => { t.onended = null; t.onmute = null; t.stop(); });
      processor = sourceNode = mediaStream = null;
    }
    function startSilenceWatchdog() {
      stopSilenceWatchdog();
      lastVoiceAt = Date.now();
      silenceWatchdogId = window.setInterval(() => {
        if (Date.now() - lastVoiceAt > SILENCE_TIMEOUT_MS) {
          stopSilenceWatchdog();
          callErr.textContent = "We can't hear you — check your microphone and try again.";
          if (ws) ws.close(1000, "no microphone audio detected");
        }
      }, 4000);
    }
    function stopSilenceWatchdog() {
      window.clearInterval(silenceWatchdogId);
      silenceWatchdogId = 0;
    }
    function stopPlayback() {
      for (const node of playing) { try { node.stop(); } catch (e) {} }
      playing.clear();
      if (audioCtx) playCursor = audioCtx.currentTime;
      setVoiceActivity(0, 0);
    }

    // ---- ringback: hear the phone ring until Jim picks up ----
    const ringback = { nodes: null, timer: 0, active: false };
    function startRingback() {
      if (!audioCtx || ringback.active) return;
      ringback.active = true;
      const gain = audioCtx.createGain();
      gain.gain.value = 0;
      gain.connect(audioCtx.destination);
      const o1 = audioCtx.createOscillator(), o2 = audioCtx.createOscillator();
      o1.frequency.value = 440; o2.frequency.value = 480;
      o1.connect(gain); o2.connect(gain);
      o1.start(); o2.start();
      ringback.nodes = { o1, o2, gain };
      const burst = () => {
        if (!ringback.active) return;
        const t = audioCtx.currentTime;
        gain.gain.cancelScheduledValues(t);
        gain.gain.setValueAtTime(0, t);
        gain.gain.linearRampToValueAtTime(0.06, t + 0.02);
        gain.gain.setValueAtTime(0.06, t + 2.0);
        gain.gain.linearRampToValueAtTime(0, t + 2.03);
      };
      burst();
      ringback.timer = setInterval(burst, 6000);
    }
    function stopRingback() {
      if (!ringback.active) return;
      ringback.active = false;
      clearInterval(ringback.timer);
      const nodes = ringback.nodes || {};
      try {
        const t = audioCtx.currentTime;
        nodes.gain.gain.cancelScheduledValues(t);
        nodes.gain.gain.linearRampToValueAtTime(0, t + 0.02);
        nodes.o1.stop(t + 0.05); nodes.o2.stop(t + 0.05);
      } catch (e) {}
      ringback.nodes = null;
    }

    function playPcm16(buf) {
      if (!audioCtx) return;
      const samples = pcm16ToFloat32(buf);
      setVoiceActivity(0, rms(samples) * 4);
      const audioBuffer = audioCtx.createBuffer(1, samples.length, outputRate);
      audioBuffer.copyToChannel(samples, 0);
      const node = audioCtx.createBufferSource();
      node.buffer = audioBuffer;
      node.connect(audioCtx.destination);
      const now = audioCtx.currentTime;
      if (playCursor <= now) playCursor = now + 0.15;
      node.start(playCursor);
      playCursor += samples.length / outputRate;
      playing.add(node);
      node.onended = () => playing.delete(node);
    }

    // ---- timer (display only — the server enforces the real budget) ----
    function renderTimer(secs) {
      const safe = Math.max(0, secs);
      timerFace.textContent = `${Math.floor(safe / 60)}:${String(Math.floor(safe % 60)).padStart(2, "0")}`;
      timerFill.style.transform = `scaleX(${safe / 300})`;
    }
    function startTimer(initialSeconds) {
      window.clearInterval(timerId);
      secondsRemaining = initialSeconds;
      renderTimer(secondsRemaining);
      timerId = window.setInterval(() => {
        secondsRemaining = Math.max(0, secondsRemaining - 0.25);
        renderTimer(secondsRemaining);
      }, 250);
    }
    function stopTimer() { window.clearInterval(timerId); timerId = 0; }

    // ---- call flow ----
    const STATE_LABELS = {
      IDLE: "Listening", LISTENING: "Listening", THINKING: "Thinking",
      SPEAKING: "Speaking", INTERRUPTING: "Listening",
    };
    function setCallLabel(label) {
      if (ringback.active && label !== "Ringing…") return;
      callState.textContent = label;
    }
    function handleEvent(data) {
      if (data.type === "hello") {
        startTimer(data.seconds_remaining ?? 300);
        outputRate = data.output_sample_rate || outputRate;
        callState.textContent = "Ringing…";
        startRingback();
      } else if (data.type === "status") {
        setCallLabel(STATE_LABELS[data.state] || "…");
      } else if (data.type === "transcript") {
        transcriptEl.textContent = "You: " + (data.text || "");
        setCallLabel("Thinking");
      } else if (data.type === "thinking") {
        setCallLabel("Thinking");
      } else if (data.type === "reply") {
        transcriptEl.textContent += "\n" + activeName + ": " + (data.text || "");
      } else if (data.type === "speech_start") {
        stopRingback();
        callState.textContent = "Speaking";
      } else if (data.type === "speech_end") {
        callState.textContent = "Listening";
      } else if (data.type === "interrupted") {
        stopPlayback();
        callState.textContent = "Listening";
      } else if (data.type === "budget_exhausted") {
        stopRingback();
        callErr.textContent = "Today's 5 minutes with " + activeName + " are up — come back tomorrow.";
      } else if (data.type === "error") {
        stopRingback();
        callErr.textContent = data.detail || "Something went wrong.";
      }
    }

    function micErrorMessage(e) {
      if (e && e.name === "NotSupportedError") return "Voice calls aren't supported in this browser — try Safari or Chrome.";
      if (e && e.name === "NotFoundError") return "No microphone found on this device.";
      if (e && e.name === "NotAllowedError") return "Microphone access is blocked — enable it in your browser/site settings and reload.";
      if (e && e.name === "NotReadableError") return "Your microphone appears to be in use by another app.";
      return "A call needs microphone access — your browser blocked it.";
    }

    async function startCall() {
      if (panel.classList.contains("is-calling")) return;
      callName.textContent = activeName;
      callState.textContent = "Calling…";
      transcriptEl.textContent = "";
      callErr.textContent = "";
      panel.classList.add("is-calling");
      screen.classList.add("is-live");
      try {
        await startMic();
      } catch (e) {
        callErr.textContent = micErrorMessage(e);
        panel.classList.remove("is-calling");
        screen.classList.remove("is-live");
        return;
      }
      const url = new URL("/ws/voice/" + activePersona, `wss://${CALL_HOST}`);
      url.searchParams.set("caller_key", callerKey());
      const protos = ["buddy.voice2"];
      if (activePersona === "buddy" && familyToken()) protos.push("token." + familyToken());
      ws = new WebSocket(url.toString(), protos);
      ws.binaryType = "arraybuffer";
      startSilenceWatchdog();
      ws.onmessage = (event) => {
        if (typeof event.data === "string") handleEvent(JSON.parse(event.data));
        else playPcm16(event.data);
      };
      ws.onclose = (event) => {
        stopRingback();
        stopSilenceWatchdog();
        if (event.reason) callState.textContent = event.reason;
        else if (event.wasClean === false || (event.code !== 1000 && event.code !== 1001)) callState.textContent = "Connection lost — check your signal";
        else callState.textContent = "Call ended";
        stopMic(); stopPlayback(); stopTimer();
        setTimeout(() => {
          screen.classList.remove("is-live");
          panel.classList.remove("is-calling");
          refreshBudget();
        }, 1600);
      };
      ws.onerror = () => {
        callErr.textContent = "Couldn't reach the line — try again in a moment.";
      };
    }

    // Preheat on hover/touch: warms Jim's brain so the greeting answers fast.
    let lastPreheat = 0;
    function preheat() {
      const now = Date.now();
      if (now - lastPreheat < 60000) return;
      lastPreheat = now;
      fetch(`https://${CALL_HOST}/api/preheat`, { method: "POST" }).catch(() => {});
    }
    choices.addEventListener("mouseenter", preheat, true);
    choices.addEventListener("touchstart", preheat, { capture: true, passive: true });

    choices.addEventListener("click", (event) => {
      const card = event.target.closest("[data-persona]");
      if (!card || card.disabled) return;
      activePersona = card.dataset.persona || "jimkai";
      activeName = card.dataset.name || "JimK.ai";
      startCall();
    });
    endCallBtn.addEventListener("click", () => { if (ws) ws.close(1000, "caller hung up"); });

    // ---- backgrounding: don't let a backgrounded tab quietly burn the daily budget ----
    document.addEventListener("visibilitychange", () => {
      if (document.hidden && panel.classList.contains("is-calling") && ws) {
        callErr.textContent = "Call ended — you switched apps or tabs.";
        ws.close(1000, "tab backgrounded");
      }
    });
    window.addEventListener("pagehide", () => { if (ws) ws.close(1000, "page hidden"); });

    renderTimer(300);
  })();
</script>
