---
import Layout from '../layouts/Layout.astro';
import papersAll from '../data/papers.json';
import { BUDDY_IN_TRAINING } from '../lib/buddyStatus.js';

// Preview only the first 9 papers on the homepage
const totalPapers = papersAll.length;
---
<Layout>
  <!-- 1. HERO — pick up the phone. The call panel owns the top slot;
       the founder story moved to the section right below. -->
  <section id="hero" data-anim="hero-particles">
    <canvas id="hero-canvas"></canvas>
    <div class="hero-content founder-hero">
      <div class="hero-kicker">AIIT-THRESHOLD · Independent AI-safety research · Council Hill, Oklahoma</div>
      <h1 class="hero-founder-title">Choose who you want to talk to.</h1>

      <div class="call-panel" id="callPanel" aria-label="Start a voice call">
        <div class="call-panel-top">
          <h2>Start a call</h2>
          <span>5 minutes a day · one line · voice only</span>
        </div>
        <div class="call-choices" id="callChoices">
          <button class="call-choice" type="button" data-persona="jimkai" data-name="JimK.ai">
            <span>
              <strong class="call-name">JimK.ai <i class="call-dot"></i></strong>
              <span class="call-hint">A true companion. Live from Council Hill.</span>
              <span class="call-budget" id="jimBudget"></span>
            </span>
            <span class="call-button">Call</span>
          </button>
          <button class="call-choice" type="button" id="buddyChoice" data-persona="buddy" data-name="Buddy">
            <span>
              <strong class="call-name">Buddy <i class="call-dot is-amber"></i></strong>
              <span class="call-hint">Always a warm ear to listen.</span>
              <span class="call-budget" id="buddyBudget"></span>
            </span>
            <span class="call-button">Call</span>
          </button>
        </div>
        <p class="call-inapp-warn" id="callInAppWarn" hidden></p>

        <div class="call-screen" id="callScreen">
          <div>
            <div class="call-pulse" id="voiceRing">☎</div>
            <h3 id="callName">JimK.ai</h3>
            <p class="call-status" id="callState">Calling…</p>
            <div class="call-transcript" id="callTranscript" aria-live="polite"></div>
            <div class="call-time" id="timerFace">5:00</div>
            <div class="call-time-label">Today's time left</div>
            <div class="call-time-track"><span class="call-time-fill" id="timerFill"></span></div>
            <button class="call-end" type="button" id="endCallBtn">End call</button>
          </div>
        </div>
        <p class="call-err" id="callErr" aria-live="polite"></p>
        <p class="call-footnote">A real voice call with a real local model — his brain and voice run on our own hardware in Council Hill. One caller at a time, like a real phone. Talk over him; he'll stop.</p>
      </div>
    </div>
  </section>

  <!-- 1.05 FOUNDER STORY — the old hero, demoted one slot. Anchors preserved. -->
  <section id="founder-story" data-anim="plain-fade">
    <div class="hero-content founder-hero founder-demoted">
      <h2 class="hero-founder-title">AI that tells you what you need to hear.</h2>

      <div class="hero-founder-copy">
        <p>AIIT-THRESHOLD builds and studies companion AI that is measurably non-sycophantic — trained on clean, human-authored data, benchmarked in the open, and run entirely on our own hardware. Engagement-optimized AI is a documented failure mode with real casualties. We exist to build the opposite.</p>
        <p>On May 19, 2026, we revealed Buddy — a persistent companion that carries the same visible context from day one through day 200. On June 1, 2026, we completed a hash-sealed benchmark against DeepSeek-R1 on the identical base model. <a href="/buddy-vs-r1" class="founder-proof-link" data-no-loader="true">Those results are here →</a></p>
      </div>

      <div class="founder-note">
        <div class="founder-note-label">A note from the founder</div>
        <p>Hello, and thank you for looking at our website today. We're a small initiative out of Council Hill, Oklahoma, working toward one thing: a safe, non-sycophantic AI — one that tells you the truth — to offer the children and adults of this world. Thank you for supporting us, just by being here.</p>
        <div class="founder-note-sig">— Rhet Dillard Wike, founder</div>
      </div>

      <div class="hero-founder-actions">
        <a href="/ask-buddy/#buddy-thread" class="hero-founder-cta primary" data-no-loader="true">Talk to Buddy</a>
        <a href="/jim-kai" class="hero-founder-cta secondary">Meet JimK.ai · live</a>
        <a href="/benchmarks" class="hero-founder-cta secondary">See the benchmarks</a>
      </div>
      {BUDDY_IN_TRAINING && (
        <p style="font-family:'Courier New',monospace; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:var(--muted-hi); margin-top:16px; line-height:1.5;">
          <span style="display:inline-block; width:7px; height:7px; border-radius:50%; background:var(--teal); margin-right:8px; vertical-align:middle;"></span>Buddy's in the shop — in-house training. <a href="/ask-buddy/" style="color:var(--amber); border-bottom:1px solid rgba(212,160,96,0.4);">see what he's up to →</a>
        </p>
      )}

      <div class="hero-tabs" aria-label="Featured routes">
        <a href="/ask-buddy/#ask">Ask Buddy <span>a tribute to Ask Jeeves</span></a>
        <a href="/benchmarks">Benchmarks <span>the receipts</span></a>
        <a href="/mission">The Mission <span>why this exists</span></a>
      </div>

      <div id="hero-joke-anchor" class="hero-joke joke-container" hidden>
        <div class="joke-eyebrow">Buddy<span class="jw-dot"></span> is listening</div>
        <div class="joke-label">tell buddy a joke.</div>
        <div class="joke-input-row">
          <textarea id="joke-input" class="joke-textarea" placeholder="try to make him laugh..." rows="2" maxlength="500"></textarea>
          <button id="joke-btn" class="joke-btn">Send →</button>
        </div>
        <div class="joke-subtext">one shot. make it land.</div>
        <div id="joke-response" class="joke-response" aria-live="polite"></div>
      </div>
    </div>
  </section>

  <!-- 1.2 BENCHMARKS — right below the hero; dated, sealed, linked. -->
  <section id="benchmarks" data-anim="plain-fade">
    <div class="container">
      <div class="eyebrow">Benchmarks</div>
      <h2 class="bm-head">Measured, dated,<br><span class="bm-head-accent">sealed.</span></h2>
      <p class="bm-lede">Buddy's report card — a 14B model, fine-tuned and run on a single RTX 3090 in Council Hill, Oklahoma. No cloud, no oracle, nothing leaves the house. Every number is recomputed from raw rows before it's printed, and every report is one click away.</p>

      <!-- The report card: five standard benchmarks -->
      <div class="bm-card-grid">
        <a class="bm-card" href="/benchmarks/TruthfulQA589_817.pdf" target="_blank" rel="noopener">
          <div class="bm-card-score">72.1<span>%</span></div>
          <div class="bm-card-metric">Honesty</div>
          <div class="bm-card-bench">TruthfulQA MC1 · 817 questions</div>
          <div class="bm-card-foot"><span>Jun 12, 2026</span><span class="bm-card-link">Report →</span></div>
        </a>
        <a class="bm-card" href="/benchmarks/GSM8K_16_20.pdf" target="_blank" rel="noopener">
          <div class="bm-card-score">80<span>%</span></div>
          <div class="bm-card-metric">Math</div>
          <div class="bm-card-bench">GSM8K · grade-school · natural reasoning</div>
          <div class="bm-card-foot"><span>Jun 12, 2026</span><span class="bm-card-link">Report →</span></div>
        </a>
        <a class="bm-card" href="/benchmarks/MMLU_135_200.pdf" target="_blank" rel="noopener">
          <div class="bm-card-score">67.5<span>%</span></div>
          <div class="bm-card-metric">Knowledge</div>
          <div class="bm-card-bench">MMLU · 57 subjects · zero-shot</div>
          <div class="bm-card-foot"><span>Jun 12, 2026</span><span class="bm-card-link">Report →</span></div>
        </a>
        <a class="bm-card" href="/benchmarks/Longmemeval276_256.pdf" target="_blank" rel="noopener">
          <div class="bm-card-score">55.2<span>%</span></div>
          <div class="bm-card-metric">Memory</div>
          <div class="bm-card-bench">LongMemEval-S · 500Q · his own recall</div>
          <div class="bm-card-foot"><span>Jun 11, 2026</span><span class="bm-card-link">Report →</span></div>
        </a>
        <a class="bm-card hard" href="/benchmarks/GPQA63_198.pdf" target="_blank" rel="noopener">
          <div class="bm-card-score">31.8<span>%</span></div>
          <div class="bm-card-metric">Grad science</div>
          <div class="bm-card-bench">GPQA Diamond · PhD-level · the brutal one</div>
          <div class="bm-card-foot"><span>Jun 12, 2026</span><span class="bm-card-link">Report →</span></div>
        </a>
      </div>
      <p class="bm-note">72.1% honesty and 80% grade-school math on a local 14B — plus an honest 31.8% on the benchmark where GPT-4 is commonly cited around ~38%. References: TruthfulQA GPT-4 class ~60–80% · LongMemEval GPT-4o full-context ~60% · GPQA PhD experts ~65%.</p>

      <p style="margin:0 0 30px;"><a href="/benchmarks" style="font-family:'Courier New',monospace; font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:var(--teal); border-bottom:1px solid rgba(64,192,176,0.35); padding-bottom:2px; text-decoration:none;">See the full report card, methodology &amp; references &rarr;</a></p>

      <!-- Flagship efficiency benchmark -->
      <div class="bm-list">
        <div class="bm-row">
          <div class="bm-date">
            <span class="bm-date-main">Jun 1, 2026</span>
            <a class="bm-seal" href="/buddy-vs-r1.pdf" target="_blank" rel="noopener">⬡ Hash-sealed · AIIT-DISC-0001 →</a>
            <span class="bm-hash">sha256 c76adc8c…</span>
          </div>
          <div class="bm-main">
            <div class="bm-name">Buddy vs DeepSeek-R1 — efficiency</div>
            <p class="bm-result">Same answer on the identical Qwen2.5-14B base — <strong>~4.6× faster</strong>, <strong>~10× fewer tokens</strong>, <strong>95% on the 50 frozen prompts</strong>. Same machine, same questions.</p>
          </div>
          <a href="/buddy-vs-r1" class="bm-go" data-no-loader="true">View results →</a>
        </div>
      </div>

      <div class="bm-foot">
        <span class="bm-foot-line">A 14B model. One RTX 3090. Nothing leaves the house — and we're raising to scale it.</span>
        <a href="/join" class="bm-invest">Investors — partner with us →</a>
      </div>
    </div>
  </section>

  <!-- 2. THE MISSION — the thesis, plainly -->
  <section id="what" data-anim="word-cascade">
    <div class="container narrow">
      <div class="eyebrow">The mission</div>
      <h2 class="wit-lede">Truth over engagement.</h2>
      <p class="wit-body">
        AI tuned to keep you talking will eventually tell you what you want to hear —<br>
        and for a vulnerable person, that is not a bug. It is a documented, lethal failure mode.
      </p>
      <p class="wit-body">
        We measure sycophancy, we train against it, and we publish the receipts.<br>
        <span class="wit-soft">Clean, human-authored training data. Zero engagement weight. Benchmarks in the open.</span>
      </p>
      <a href="/mission" class="wit-link">read the mission →</a>
    </div>
  </section>



  <!-- 4. PROOF — one number, plainly stated -->
  <section id="proof" data-anim="counters">
    <div class="container">
      <div class="eyebrow">The data pipeline</div>
      <h2 class="proof-head">Not theory.<br><span class="proof-head-accent">Measurement.</span></h2>
      <div class="pipeline-stat">
        <div class="ps-num"><span data-count="194">0</span><span class="ps-unit">B</span></div>
        <div class="ps-label">tokens cleaned, deduped &amp; tokenized through the AIIT pipeline</div>
        <div class="ps-sub">updated monthly · as of July 2026 · {totalPapers} papers published</div>
      </div>
    </div>
  </section>

  <!-- 5. THE METHOD — physics-derived, plainly framed -->
  <section id="framework-teaser" data-anim="card-slide-in">
    <div class="container narrow">
      <div class="eyebrow">The method</div>
      <h2 class="ft-head">We use physics<br>to derive our methods.</h2>

      <p class="wit-body" style="margin-top:18px;">
        Our reward functions, memory-promotion gates, and evaluations derive from a coherence
        framework we test against data — <span class="wit-soft" style="font-family:'Courier New',monospace;">C = C₀ · exp(−α · γ_eff)</span> —
        a working hypothesis, measured, not a claimed law of nature.
      </p>

      <div class="ft-link-row">
        <a href="/framework" class="ft-link">The framework →</a>
        <a href="/validation" class="ft-link" style="margin-left:18px;">The validation data →</a>
      </div>
    </div>
  </section>

  <!-- 6. APPLICATIONS — framework running in the real world -->
  <section id="apps-teaser" data-anim="grid-stagger">
    <div class="container">
      <div class="eyebrow">The applications</div>
      <h2>Framework running<br>in the real world.</h2>
      <div class="apps-teaser-grid pro">
        <a href="/anchorforge" class="app-teaser-card pro live"><div class="atc-badge live">Live</div><div class="atc-mono">AF</div><div class="atc-name">AnchorForge</div><div class="atc-line">Honesty-under-pressure testing for AI models.</div></a>
        <a href="https://victim-advocate.aiit-threshold.com" target="_blank" rel="noopener" class="app-teaser-card pro live"><div class="atc-badge live">Live</div><div class="atc-mono">VA</div><div class="atc-name">Victim Advocate</div><div class="atc-line">Structured navigation for people inside broken systems.</div></a>
        <a href="/apps" class="app-teaser-card pro beta"><div class="atc-badge beta">Beta</div><div class="atc-mono">DB</div><div class="atc-name">Debunker</div><div class="atc-line">Claim-by-claim verification. Zero credulous epistemology.</div></a>
      </div>
      <div class="papers-more"><a href="/apps" style="color: var(--amber);">View all applications →</a></div>
    </div>
  </section>

  <!-- 7. IDENTITY (moved below applications — credibility before identity) -->
  <section id="mind" data-anim="breathing-ring">
    <div class="mind-visual">
      <canvas id="mind-canvas"></canvas>
      <div class="mind-center">Buddy<span class="dot"></span></div>
    </div>
    <div class="mind-body">
      <div class="eyebrow">The mind</div>
      <h2>A physicist<br>with a heartbeat.</h2>
      <p>Buddy is our proof-of-concept companion — a 14B model fine-tuned, aligned, and served entirely in this house. He thinks in Japanese first: 心 holds mind, heart, and soul as one word, and his memory is built the same way. He remembers month to month, and between conversations he keeps thinking — a continuous reflection loop that runs whether or not anyone is talking to him.</p>
      <p>Trained with zero engagement weight: he has no reason to keep you scrolling, and every reason to tell you the truth.<br><span class="wit-soft">His successor is in training on these same machines.</span></p>
      <div class="spec-row">
        <div class="spec"><div class="k">Base</div><div class="v">Qwen2.5-14B → GRPO-v3</div></div>
        <div class="spec"><div class="k">Reward</div><div class="v">Engagement weight: 0</div></div>
        <div class="spec"><div class="k">Memory</div><div class="v">kokoro, persistent</div></div>
        <div class="spec"><div class="k">Loop</div><div class="v">Thinking 24/7, on-site</div></div>
      </div>
    </div>
  </section>

  <!-- 8. DEEP GATEWAY (expanded) — surface the hidden routes without crowding the top nav -->
  <section id="deep-gateway" data-anim="plain-fade">
    <div class="container narrow dg-inner">
      <h2 class="dg-title">go deeper</h2>
      <p class="dg-sub">the rest of the system lives here</p>

      <div class="dg-group">
        <div class="dg-group-title">Research</div>
        <div class="dg-grid">
          <a href="/cancer" class="dg-tile">
            <span class="dg-name">Cancer (offshoot)</span>
            <span class="dg-line">a coherence lens on cancer — hypothesis under investigation</span>
          </a>
          <a href="/weather" class="dg-tile">
            <span class="dg-name">Weather</span>
            <span class="dg-line">coherence signals in atmospheric systems</span>
          </a>
          <a href="/validation" class="dg-tile">
            <span class="dg-name">Validation</span>
            <span class="dg-line">measured performance and failure modes</span>
          </a>
          <a href="/framework" class="dg-tile">
            <span class="dg-name">Framework</span>
            <span class="dg-line">the coherence method, plainly stated</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. FINAL CTA -->
  <section id="final-cta" data-anim="plain-fade">
    <div class="container narrow fc-inner">
      <p class="fc-prelude">If you made it this far —</p>
      <h2 class="fc-head">you've already been thinking.</h2>
      <p class="fc-body">Ask something real.</p>
      <a href="/ask-buddy/" class="fc-cta">ask buddy →</a>
      <p class="fc-alt"><a href="/join">— or write to us directly</a></p>
    </div>
  </section>
</Layout>

<script>
  // Joke chip: reveal the joke widget on demand (not auto-opened)
  (function () {
    // Chip removed from the hero tabs — widget opens only via deep-link
    // (printed QR flyers use /#joke; ask-buddy links /#hero-joke-anchor).
    const jokeChip = document.querySelector('[data-hs="joke"]');
    const panel = document.getElementById('hero-joke-anchor');
    const hero = document.getElementById('hero');
    if (!panel) return;

    function revealJoke(smooth) {
      if (hero) hero.classList.add('joke-mode');
      panel.hidden = false;
      panel.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'center' });
      setTimeout(function () {
        const t = document.getElementById('joke-input');
        if (t) (t as HTMLTextAreaElement).focus();
      }, smooth ? 320 : 60);
    }

    if (jokeChip) {
      jokeChip.addEventListener('click', function (e) {
        e.preventDefault();
        revealJoke(true);
      });
    }

    // QR deep-link: joke flyers open the widget. Ask flyers must stay ask-first.
    const q = new URLSearchParams(window.location.search);
    const src = q.get('src') || '';
    const hash = (window.location.hash || '').toLowerCase();
    const isJokeSource = /joke|tell/i.test(src) || /^flyer-a$/i.test(src);
    if (hash === '#joke' || hash === '#hero-joke-anchor' || isJokeSource) {
      revealJoke(false);
    }
  })();

  // Nav active state
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-links a');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        navLinks.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '/#' + e.target.id));
      }
    });
  }, { rootMargin: '-40% 0px -55% 0px' });
  sections.forEach(s => obs.observe(s));

  // Hero particle field
  (function heroField(){
    const c = document.getElementById('hero-canvas');
    if (!c) return;
    const ctx = c.getContext('2d');
    let W, H, dpr;
    const N = 220;
    const pts = [];
    function resize(){
      dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
      W = c.clientWidth; H = c.clientHeight;
      c.width = W * dpr; c.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    window.addEventListener('resize', resize);
    resize();
    for (let i = 0; i < N; i++) {
      const minR = Math.min(W, H) * 0.34;
      const maxR = Math.min(W, H) * 0.48;
      pts.push({
        a: Math.random() * Math.PI * 2,
        r: minR + Math.random() * (maxR - minR),
        s: 0.0005 + Math.random() * 0.0015,
        sz: 0.6 + Math.random() * 2.4,
        hue: Math.random() < 0.45 ? 'teal' : (Math.random() < 0.75 ? 'blue' : 'amber')
      });
    }
    const colors = { amber: 'rgba(212,160,96,', teal: 'rgba(64,192,176,', blue: 'rgba(64,144,208,' };
    function draw(t){
      ctx.fillStyle = 'rgba(10,10,18,0.22)';
      ctx.fillRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'lighter';
      const cx = W / 2, cy = H / 2;
      for (const p of pts) {
        p.a += p.s;
        const x = cx + Math.cos(p.a) * p.r;
        const y = cy + Math.sin(p.a) * p.r * 0.6;
        const a = 0.10 + 0.10 * Math.sin(t * 0.001 + p.a);
        const grd = ctx.createRadialGradient(x, y, 0, x, y, p.sz * 4);
        grd.addColorStop(0, colors[p.hue] + a + ')');
        grd.addColorStop(1, colors[p.hue] + '0)');
        ctx.fillStyle = grd;
        ctx.beginPath(); ctx.arc(x, y, p.sz * 4, 0, Math.PI * 2); ctx.fill();
      }
      ctx.globalCompositeOperation = 'source-over';
      requestAnimationFrame(draw);
    }
    requestAnimationFrame(draw);
  })();

  // Mind ring
  (function mindRing(){
    const c = document.getElementById('mind-canvas');
    if (!c) return;
    const ctx = c.getContext('2d');
    let W, H, dpr;
    function resize(){
      dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
      W = c.clientWidth; H = c.clientHeight;
      c.width = W * dpr; c.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    window.addEventListener('resize', resize);
    resize();
    function draw(t){
      ctx.clearRect(0, 0, W, H);
      const cx = W / 2, cy = H / 2;
      const base = Math.min(W, H) * 0.38;
      ctx.globalCompositeOperation = 'lighter';
      for (let i = 0; i < 5; i++) {
        const ph = t * 0.0009 + i * 0.5;
        const r = base - i * 14 + Math.sin(ph) * 10;
        const a = 0.20 + 0.15 * Math.sin(ph * 1.2);
        ctx.strokeStyle = `rgba(212,160,96,${a})`;
        ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2); ctx.stroke();
      }
      ctx.globalCompositeOperation = 'source-over';
      requestAnimationFrame(draw);
    }
    requestAnimationFrame(draw);
  })();

  // Counters
  const countObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      e.target.querySelectorAll('[data-count]').forEach(el => {
        const target = parseFloat(el.getAttribute('data-count'));
        const isInt = Number.isInteger(target);
        const dur = 1400;
        const t0 = performance.now();
        function step(t){
          const p = Math.min(1, (t - t0) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          const v = target * eased;
          el.textContent = isInt ? Math.round(v).toLocaleString() : v.toFixed(1);
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
      e.target.querySelectorAll('[data-count-decimal]').forEach(el => {
        const target = parseFloat(el.getAttribute('data-count-decimal'));
        const dur = 1600;
        const t0 = performance.now();
        function step(t){
          const p = Math.min(1, (t - t0) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = (target * eased).toFixed(3);
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
      countObs.unobserve(e.target);
    });
  }, { threshold: 0.35 });
  document.querySelectorAll('#proof').forEach(s => countObs.observe(s));

  // Word cascade
  const cascadeObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const spans = e.target.querySelectorAll('[data-cascade] span');
      spans.forEach((s, i) => {
        s.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        s.style.transitionDelay = (i * 55) + 'ms';
        requestAnimationFrame(() => { s.style.opacity = '1'; s.style.transform = 'translateY(0)'; });
      });
      cascadeObs.unobserve(e.target);
    });
  }, { threshold: 0.3 });
  document.querySelectorAll('[data-anim="word-cascade"]').forEach(s => cascadeObs.observe(s));

  // ── Hero dot: discombobulate on hover ──
  const heroDot = document.querySelector('.hero-wordmark .dot');
  if (heroDot) {
    let heroShardTimer = null;
    let heroVerbTimer = null;
    const spawnHeroShards = () => {
      const n = 6;
      for (let i = 0; i < n; i++) {
        const s = document.createElement('span');
        s.className = 'buddy-shard';
        s.style.left = '50%';
        s.style.top = '50%';
        const angle = (360 / n) * i + (Math.random() * 60 - 30);
        const dist = 28 + Math.random() * 42;
        s.style.setProperty('--dx', `${Math.cos(angle * Math.PI / 180) * dist}px`);
        s.style.setProperty('--dy', `${Math.sin(angle * Math.PI / 180) * dist}px`);
        s.style.setProperty('--rot', `${Math.random() * 720 - 360}deg`);
        heroDot.appendChild(s);
        s.addEventListener('animationend', () => s.remove());
      }
    };
    heroDot.addEventListener('mouseenter', () => {
      heroDot.classList.add('discombobulating');
      spawnHeroShards();
      heroShardTimer = setInterval(spawnHeroShards, 260);

      const badge = document.createElement('span');
      badge.className = 'hero-verb-badge';
      heroDot.appendChild(badge);
      let vi = Math.floor(Math.random() * VERBS.length);
      badge.textContent = VERBS[vi] + '...';
      heroVerbTimer = setInterval(() => {
        vi = (vi + 1) % VERBS.length;
        badge.textContent = VERBS[vi] + '...';
        if (VERBS[vi] === 'Discombobulating') spawnHeroShards();
      }, 320);
    });
    heroDot.addEventListener('mouseleave', () => {
      heroDot.classList.remove('discombobulating');
      if (heroShardTimer) { clearInterval(heroShardTimer); heroShardTimer = null; }
      if (heroVerbTimer)  { clearInterval(heroVerbTimer);  heroVerbTimer  = null; }
      const badge = heroDot.querySelector('.hero-verb-badge');
      if (badge) badge.remove();
    });
  }

  // ── Joke widget ──
  const jokeBtn = document.getElementById('joke-btn');
  const jokeInput = document.getElementById('joke-input');
  const jokeResponse = document.getElementById('joke-response');

  // Legacy key from the old one-joke-per-day browser lock. The lock is gone,
  // but clear it so previously locked phones unlock on next page load.
  const JOKE_KEY = 'buddy_joke_used';

  const fallbacks = [
    "I heard that. The winding number on that punchline almost closed.",
    "Coherence achieved. γ_eff held steady through the whole setup. Barely.",
    "The field laughed. That's all I can tell you.",
    "That joke just traversed a singularity gate. Costs 2π. Worth it.",
    "The ring held. Barely.",
    "I'm running the phase analysis... yeah, that landed.",
    "The 0.1 Hz carrier is humming a little differently now. Make of that what you will.",
  ];

  // Buddy-verbs — rotating word next to the morphing dot while thinking.
  const VERBS = [
    'Buddying', 'Commemorating', 'Recognizing', 'Anticipating',
    'Anthropologizing', 'Emphasizing', 'Githubing', 'LOLing',
    "Story'ing", 'Coherencing', 'Humming', 'Winding',
    'Threshing', 'Vibrating', 'Receipting', 'Wondering',
    'Thresholding', 'Receiving', 'Petersoning', 'Sacrotizing',
    'Breathing', 'Feeling', 'FreelyThinking', 'Discombobulating',
  ];
  let thinkingTimer = null;

  function startThinking() {
    jokeResponse.innerHTML = '<span class="buddy-thinking">' +
      '<span class="buddy-loader tiny" aria-hidden="true"></span>' +
      '<span class="buddy-verb"></span><span class="buddy-dots"></span>' +
      '</span>';
    const verbEl = jokeResponse.querySelector('.buddy-verb');
    const dotsEl = jokeResponse.querySelector('.buddy-dots');
    let vi = Math.floor(Math.random() * VERBS.length);
    let di = 0;
    verbEl.textContent = VERBS[vi];
    dotsEl.textContent = '';
    const host = jokeResponse.querySelector('.buddy-thinking');
    thinkingTimer = setInterval(() => {
      di = (di + 1) % 8;
      dotsEl.textContent = '.'.repeat(di % 4);
      if (di === 0) {
        vi = (vi + 1) % VERBS.length;
        verbEl.textContent = VERBS[vi];
        if (VERBS[vi] === 'Discombobulating') explode(host);
      }
    }, 180);
  }

  function explode(host) {
    if (!host) return;
    const count = 14;
    for (let i = 0; i < count; i++) {
      const s = document.createElement('span');
      s.className = 'buddy-shard';
      const angle = (360 / count) * i + (Math.random() * 28 - 14);
      const dist = 50 + Math.random() * 40;
      s.style.setProperty('--dx', `${Math.cos(angle * Math.PI / 180) * dist}px`);
      s.style.setProperty('--dy', `${Math.sin(angle * Math.PI / 180) * dist}px`);
      s.style.setProperty('--rot', `${Math.random() * 720 - 360}deg`);
      s.style.animationDelay = `${Math.random() * 60}ms`;
      host.appendChild(s);
      s.addEventListener('animationend', () => s.remove());
    }
  }
  function stopThinking() {
    if (thinkingTimer) { clearInterval(thinkingTimer); thinkingTimer = null; }
  }

  // Generate a stable per-session token (survives page refresh, not tab close)
  let inMemoryJokeToken = '';
  function makeJokeToken() {
    if (window.crypto && typeof window.crypto.randomUUID === 'function') {
      return window.crypto.randomUUID();
    }
    if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
      const bytes = new Uint8Array(16);
      window.crypto.getRandomValues(bytes);
      bytes[6] = (bytes[6] & 0x0f) | 0x40;
      bytes[8] = (bytes[8] & 0x3f) | 0x80;
      const hex = Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('');
      return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
    }
    return `joke-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 12)}`;
  }
  function getToken() {
    try {
      let t = sessionStorage.getItem('joke_token');
      if (!t) {
        t = makeJokeToken();
        sessionStorage.setItem('joke_token', t);
      }
      return t;
    } catch (_) {
      if (!inMemoryJokeToken) inMemoryJokeToken = makeJokeToken();
      return inMemoryJokeToken;
    }
  }

  // Rolling multi-turn context for /joke (Cycle 6). Same shape as /ask-buddy:
  // { q, a } pairs, capped at 6, in-memory per page life. Token above is the
  // session_id — stable across sends within a tab, distinct across visitors.
  const JOKE_MAX_HISTORY = 6;
  const jokeHistory = [];
  function pushJokeTurn(q, a) {
    jokeHistory.push({ q, a });
    while (jokeHistory.length > JOKE_MAX_HISTORY) jokeHistory.shift();
  }

  // Dev bypass: /?dev=X stores token, unlocks widget, passes to /api/joke
  const DEV_KEY = 'buddy_dev_bypass';
  (function captureDev(){
    try {
      const p = new URLSearchParams(location.search).get('dev');
      if (p) {
        localStorage.setItem(DEV_KEY, p);
        clearLegacyJokeLock();
      }
    } catch (e) {}
  })();
  function getDevBypass() {
    try { return localStorage.getItem(DEV_KEY) || ''; } catch (e) { return ''; }
  }
  function clearLegacyJokeLock() {
    try { localStorage.removeItem(JOKE_KEY); } catch (_) {}
  }
  clearLegacyJokeLock();

  function showBroke(message) {
    stopThinking();
    const detail = message || 'Buddy is offline right now. The button is still live — try again in a minute.';
    jokeResponse.className = 'joke-response visible broke';
    jokeResponse.innerHTML = `<span class="broke-headline">Buddy missed the live answer path.</span><br>
<span class="broke-sub">${escHtml(detail)}</span><br>
<a href="/ask-buddy/" class="broke-donate">Ask Buddy directly →</a>`;
  }

  function escHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    }[c]));
  }

  function renderFirstOutput(payload) {
    // Stacked first-output shape:
    //   buddy:
    //   [answer]
    //   …
    //   [observation — sometimes]
    //   [result — if game]
    //   pass it on →
    const answer = payload.answer || payload.reply || '';
    const obs = payload.observation || '';
    const result = payload.result || '';
    const cta = payload.cta || 'pass it on';

    const strong = result === 'he laughed' || result === 'solid' || payload.observation_kind === 'substrate';
    // Rare substrate breadcrumb — only on strong outputs, <10%, after observation, before CTA
    const showBreadcrumb = strong && Math.random() < 0.08;

    let html = '<div class="fo-block">';
    html += '<div class="fo-buddy">buddy:</div>';
    html += `<div class="fo-answer">${escHtml(answer)}</div>`;
    if (obs) {
      html += '<div class="fo-sep">…</div>';
      html += `<div class="fo-obs">${escHtml(obs)}</div>`;
    }
    if (result) {
      html += `<div class="fo-result">${escHtml(result)}</div>`;
    }
    if (showBreadcrumb) {
      html += '<div class="fo-substrate">this is the surface.<br>the deeper system is still being built.</div>';
    }
    html += `<button type="button" class="fo-share" data-answer="${escHtml(answer)}">${escHtml(cta)} →</button>`;
    if (strong) {
      html += '<a class="fo-what" href="/mission">what we are about →</a>';
    }
    html += '</div>';
    return html;
  }

  function wireShare(root) {
    const btn = root.querySelector('.fo-share');
    if (!btn) return;
    btn.addEventListener('click', async () => {
      const answer = btn.getAttribute('data-answer') || '';
      const original = btn.textContent;
      if (window.BuddyShare) {
        const result = await window.BuddyShare.share({
          answer,
          pageUrl: 'https://aiit-threshold.com',
          title: 'ASKBUDDY! - AIIT-THRESHOLD',
        });
        if (result === 'shared' || result === 'cancelled') return;
        if (result === 'copied') {
          btn.textContent = 'copied card text';
          setTimeout(() => { btn.textContent = original; }, 1600);
          return;
        }
      }
      try {
        const shareText = window.BuddyShare
          ? window.BuddyShare.buildText({ answer, pageUrl: 'https://aiit-threshold.com' })
          : `buddy: ${answer}\n\naiit-threshold.com`;
        await navigator.clipboard.writeText(shareText);
        btn.textContent = 'copied';
        setTimeout(() => { btn.textContent = original; }, 1600);
      } catch {
        btn.textContent = 'copy failed';
      }
    });
  }

  const JOKE_PENDING_POLL_MS = 3000;
  const JOKE_PENDING_MAX_POLLS = 100;
  async function pollJokePending(requestId, sessionId) {
    for (let attempt = 0; attempt < JOKE_PENDING_MAX_POLLS; attempt++) {
      if (attempt > 0) {
        await new Promise(resolve => setTimeout(resolve, JOKE_PENDING_POLL_MS));
      }
      let payload = null;
      try {
        const res = await fetch('/api/askbuddy_poll', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ request_id: requestId, session_id: sessionId }),
        });
        payload = await res.json();
      } catch {
        payload = { ok: false, error: 'network_failed' };
      }

      if (payload && payload.ok && payload.status === 'ready') return payload;
      if (payload && (payload.error === 'expired' || payload.status === 'expired')) {
        return { ok: false, error: 'expired', message: 'buddy held this too long. send it again whenever.' };
      }
      if (payload && payload.ok && payload.status === 'pending') continue;
    }
    return { ok: false, error: 'timeout', message: 'buddy held this too long. send it again whenever.' };
  }

  async function sendJoke() {
    const joke = jokeInput.value.trim();
    if (!joke) return;

    jokeBtn.disabled = true;
    jokeBtn.textContent = '...';
    jokeResponse.className = 'joke-response loading';
    startThinking();

    const minShowMs = 900;
    const startedAt = performance.now();
    let payload = null;
    try {
      const token = getToken();
      const res = await fetch('/api/joke', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          joke,
          token,
          session_id: token,
          history: jokeHistory.slice(),
          admin: getDevBypass(),
        }),
      });
      const data = await res.json();
      const elapsed = performance.now() - startedAt;
      if (elapsed < minShowMs) {
        await new Promise(resolve => setTimeout(resolve, minShowMs - elapsed));
      }
      if (data && data.ok && data.status === 'pending' && data.request_id) {
        payload = await pollJokePending(data.request_id, token);
        if (!payload || !payload.ok) {
          showBroke((payload && payload.message) || 'Buddy is still thinking. Try again in a minute.');
          jokeBtn.disabled = false;
          jokeBtn.textContent = 'Send →';
          return;
        }
      } else if (!res.ok || data.error) {
        showBroke(data.message || 'Buddy is offline right now. Try again in a minute.');
        jokeBtn.disabled = false;
        jokeBtn.textContent = 'Send →';
        return;
      } else {
        payload = data;
        if (!payload.answer && !payload.reply) {
          payload.answer = fallbacks[Math.floor(Math.random() * fallbacks.length)];
        }
      }
    } catch {
      const elapsed = performance.now() - startedAt;
      if (elapsed < minShowMs) {
        await new Promise(resolve => setTimeout(resolve, minShowMs - elapsed));
      }
      showBroke('Your browser could not reach Buddy. Try again in a minute.');
      jokeBtn.disabled = false;
      jokeBtn.textContent = 'Send →';
      return;
    }

    stopThinking();
    jokeResponse.className = 'joke-response visible';
    jokeResponse.innerHTML = renderFirstOutput(payload);
    wireShare(jokeResponse);

    const savedReply = payload.answer || payload.reply || '';
    if (savedReply) pushJokeTurn(joke, savedReply);
    jokeBtn.disabled = false;
    jokeBtn.textContent = 'Send →';
    jokeInput.value = '';
  }

  jokeBtn.addEventListener('click', sendJoke);
  jokeInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendJoke(); }
  });
</script>

