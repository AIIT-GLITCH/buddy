---
import Layout from '../layouts/Layout.astro';
---
<Layout title="AnchorForge ProofDesk — The Proof Trail Is Missing" description="Turn messy evidence folders into sealed proof packets. Manifests, hashes, chain of custody, claim review, risk register, sealed archive. For inventors, founders, attorneys, AI agencies.">

<section style="padding-top: 160px; min-height: 80vh;">
  <div class="container narrow" style="max-width: 960px; margin: 0 auto; padding: 0 5vw;">

    <div class="eyebrow">AnchorForge ProofDesk</div>
    <h1 style="font-size: clamp(2.4rem, 6vw, 5rem); margin-bottom: 20px; line-height: 1.1;">The claim is cheap.<br>The proof trail<br>is missing.</h1>
    <p class="pd-lede">
      ProofDesk turns messy evidence folders into sealed proof packets: manifests, hashes, chain of custody,
      claim review, risk register, handoff memo, source copy, sealed archive, and optional printable binder.
    </p>

    <div class="pd-cta-row">
      <a href="mailto:reliablerestaurantrepair@gmail.com?subject=ProofDesk%20Run" class="btn-buy">Start a ProofDesk run →</a>
      <a href="#pricing" class="pd-link">See pricing ↓</a>
    </div>

    <!-- WHAT YOU GET -->
    <div style="margin-top: 80px;">
      <div class="eyebrow">What you get</div>
      <h2 style="font-size: clamp(1.4rem, 3.5vw, 2rem); margin-bottom: 24px;">Nine outputs. One sealed packet.</h2>

      <div class="pd-grid">
        <div class="pd-item"><div class="pd-icon">📋</div><h3>MANIFEST.tsv</h3><p>Every file indexed, timestamped, and cataloged.</p></div>
        <div class="pd-item"><div class="pd-icon">🔐</div><h3>SHA256SUMS.txt</h3><p>Cryptographic hash of every artifact. Tamper-proof.</p></div>
        <div class="pd-item"><div class="pd-icon">🔗</div><h3>CHAIN_OF_CUSTODY.md</h3><p>Who touched what, when, and why. The timeline that holds.</p></div>
        <div class="pd-item"><div class="pd-icon">🔍</div><h3>CLAIM_REVIEW_TABLE.md</h3><p>Every claim mapped to its supporting evidence. Gaps named.</p></div>
        <div class="pd-item"><div class="pd-icon">⚠️</div><h3>RISK_REGISTER.md</h3><p>What could be challenged. What's thin. Where to strengthen.</p></div>
        <div class="pd-item"><div class="pd-icon">📝</div><h3>HANDOFF_MEMO.md</h3><p>The note your attorney, investor, or reviewer reads first.</p></div>
        <div class="pd-item"><div class="pd-icon">📁</div><h3>Source copy</h3><p>Clean copy of every original artifact, organized and labeled.</p></div>
        <div class="pd-item"><div class="pd-icon">📦</div><h3>Sealed zip</h3><p>Hash-sealed archive. One file, one checksum, one truth.</p></div>
        <div class="pd-item"><div class="pd-icon">📖</div><h3>Printable binder</h3><p>Optional. Physical binder-ready output for court, filing, or handoff.</p></div>
      </div>
    </div>

    <!-- WHO IT'S FOR -->
    <div style="margin-top: 64px;">
      <div class="eyebrow">Who it's for</div>
      <div class="pd-audience">
        <div class="pd-who"><strong>Inventors</strong> — provisional patents, disclosure timelines, prior art defense</div>
        <div class="pd-who"><strong>Founders</strong> — investor packets, launch claims, IP protection</div>
        <div class="pd-who"><strong>Attorneys</strong> — client chaos → attorney-ready packets before billable hours start</div>
        <div class="pd-who"><strong>AI agencies</strong> — verified-source reports instead of AI-generated claims</div>
        <div class="pd-who"><strong>Consultants</strong> — stop shipping claims without a trail</div>
      </div>
    </div>

    <!-- PRICING -->
    <div id="pricing" style="margin-top: 64px;">
      <div class="eyebrow">Pricing</div>
      <h2 style="font-size: clamp(1.4rem, 3.5vw, 2rem); margin-bottom: 24px;">Four tiers. Pick the one that fits.</h2>

      <div class="pd-pricing-grid">
        <div class="pd-price-card">
          <div class="pd-tier">Starter Proof Seal</div>
          <div class="pd-price">$149</div>
          <p>Small folder. Manifest, hashes, chain-of-custody, sealed zip. Fast and clean.</p>
        </div>
        <div class="pd-price-card">
          <div class="pd-tier">Founder Proof Packet</div>
          <div class="pd-price">$499</div>
          <p>Claim table, risk register, handoff memo, sealed packet. For launches, pitches, and investor meetings.</p>
        </div>
        <div class="pd-price-card pd-featured">
          <div class="pd-tier">Patent / AI Evidence Binder</div>
          <div class="pd-price">$999</div>
          <p>Invention disclosure worksheet, citation/source verification, binder-ready output. The full defensive chronology.</p>
        </div>
        <div class="pd-price-card">
          <div class="pd-tier">Emergency Weekend Desk</div>
          <div class="pd-price">$1,999</div>
          <p>24-hour rush packet. For urgent disputes, deadlines, launches, takedowns, and high-pressure evidence cleanup.</p>
        </div>
      </div>
    </div>

    <!-- WHY -->
    <div style="margin-top: 64px;">
      <div class="eyebrow">Why it matters</div>
      <p style="color: var(--slate); font-size: 1.05rem; line-height: 1.8; max-width: 600px;">
        Courts, investors, partners, and clients do not buy vibes. They need receipts.
        The world is about to drown in AI-generated claims. The money is in making proof legible.
      </p>
    </div>

    <!-- FINAL CTA -->
    <div style="margin-top: 64px; padding-bottom: 80px; text-align: center;">
      <h2 style="font-size: clamp(1.4rem, 3.5vw, 2rem); margin-bottom: 12px;">Bring the folder.<br>Leave with receipts.</h2>
      <a href="mailto:reliablerestaurantrepair@gmail.com?subject=ProofDesk%20Run" class="btn-buy" style="margin-top: 24px;">
        Start a ProofDesk run →
      </a>
      <p style="color: var(--slate); font-size: 0.85rem; margin-top: 24px;">
        Contact: <a href="mailto:reliablerestaurantrepair@gmail.com" style="color: var(--amber);">reliablerestaurantrepair@gmail.com</a>
      </p>
    </div>

  </div>
</section>

<style>
  .pd-lede {
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    color: var(--slate, #8A9AB5);
    line-height: 1.8;
    margin-bottom: 32px;
    max-width: 680px;
  }

  .pd-cta-row {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .pd-link {
    color: var(--amber, #D4AF37);
    text-decoration: none;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
    border-bottom: 1px solid rgba(212, 164, 55, 0.3);
    padding-bottom: 2px;
  }

  .pd-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .pd-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(212, 164, 55, 0.12);
    border-radius: 10px;
    padding: 20px 16px;
    transition: border-color 0.2s;
  }

  .pd-item:hover { border-color: rgba(212, 164, 55, 0.35); }
  .pd-icon { font-size: 1.4rem; margin-bottom: 8px; }
  .pd-item h3 { color: var(--cream, #E8E0D4); font-size: 0.95rem; margin-bottom: 4px; font-family: 'Courier New', monospace; }
  .pd-item p { color: var(--slate, #8A9AB5); font-size: 0.85rem; line-height: 1.5; }

  .pd-audience {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pd-who {
    color: var(--slate, #8A9AB5);
    font-size: 0.95rem;
    line-height: 1.6;
    padding: 12px 16px;
    border-left: 3px solid rgba(212, 164, 55, 0.25);
  }

  .pd-who strong { color: var(--amber, #D4AF37); }

  .pd-pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }

  .pd-price-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(212, 164, 55, 0.15);
    border-radius: 10px;
    padding: 28px 20px;
    text-align: center;
  }

  .pd-featured {
    border-color: var(--amber, #D4AF37);
    background: rgba(212, 164, 55, 0.06);
  }

  .pd-tier {
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
    color: var(--amber, #D4AF37);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .pd-price {
    font-size: 2.4rem;
    color: var(--cream, #E8E0D4);
    font-weight: 700;
    margin-bottom: 12px;
  }

  .pd-price-card p {
    color: var(--slate, #8A9AB5);
    font-size: 0.85rem;
    line-height: 1.5;
  }
</style>

</Layout>
