                "こんにちは", "さようなら", "おはよう", "おやすみ"}
     if val.lower() in junk_en or val in junk_ja:
         return True
+    # Bracket scaffolding / kokoro token salad must never be stored.
+    if _is_bracket_scaffolding(val):
+        return True
